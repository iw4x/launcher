./: {*/ -build/ -electron/ -material/}                       \
    doc{README.md NEWS}                                      \
    legal{LICENSE.md LICENSE-EXCEPTION.md AUTHORS}           \
    manifest                                                 \
    file{app.stamp}

# We run the JavaScript tools in a container built from Containerfile, with
# all capabilities dropped and a read-only root file system. The only host
# directory that the container sees is our output directory (mounted at
# /out), so each step copies its inputs into stage/ and runs its tool there.
# Note that the tools keep their caches in cache/.
#
podman = $config.launcher_electron.podman
image  = localhost/launcher-electron

run = $podman run --rm                              \
      --userns=keep-id                              \
      --cap-drop=all                                \
      --security-opt=no-new-privileges              \
      --read-only                                   \
      --tmpfs=/tmp                                  \
      "--volume=$out_base:/out:Z"                   \
      --env=HOME=/out/cache/home                    \
      --env=npm_config_cache=/out/cache/npm         \
      --env=electron_config_cache=/out/cache/electron

stage = [dir_path] $out_base/stage/
cache = [dir_path] $out_base/cache/

gallery = $config.launcher_electron.gallery

# Map our target to Electron's platform and architecture names.
#
switch $cxx.target.class
{
  case 'linux'
    platform = linux
  case 'windows'
    platform = win32
  case 'macos'
    platform = darwin
  default
    fail "unsupported target class $cxx.target.class"
}

switch $cxx.target.cpu
{
  case 'x86_64'
    arch = x64
  case 'aarch64'
    arch = arm64
  default
    fail "unsupported target cpu $cxx.target.cpu"
}

# Build the container image. Note that Containerfile needs no build context,
# so we pass it on stdin.
#
file{image.stamp}: file{Containerfile}
{{
  diag podman ($<)

  $podman build --quiet --tag $image - <=$path($<) >-
  touch $path($>)
}}

# Substitute the project version (the version without the epoch and
# revision) as the npm package version since npm requires a semantic
# version.
#
file{package.json}:      in{package.json.in}
file{package-lock.json}: in{package-lock.json.in}

# Install the dependencies pinned by the lockfile. This is the only step with
# network access. Install scripts are disabled in the image (see
# Containerfile), so we run Electron's explicitly to download the Electron
# archive for our target into the cache.
#
# Note: stage/ and cache/ outlive the recipe, thus --no-cleanup is required
# for the mkdir and cp builtin calls.
#
file{node-modules.stamp}: file{image.stamp}                         \
                          file{package.json package-lock.json}
% update
{{
  diag npm ($<[1])

  mkdir --no-cleanup -p $stage $cache/home
  cp --no-cleanup $path($<[1]) $path($<[2]) $stage

  $run --network=pasta $image npm ci >-

  $run --network=pasta                         \
    --env=npm_config_platform=$platform        \
    --env=npm_config_arch=$arch                \
    $image node node_modules/electron/install.js

  touch $path($>)
}}
% [diag=clean] clean
{{
  rm -r -f $stage $cache $path($>) $path($>).d
}}

# Bundle the code of each Electron process into stage/dist/, along with the
# component gallery if so configured.
#
# Note that we first generate the tokens that are computed at build time
# (color and motion) into stage/material/generated/ since the code imports
# them, and then type-check the TypeScript (configuration files included).
#
file{bundle.stamp}: file{node-modules.stamp}                           \
                    file{tsconfig.json}                                \
                    file{vite.main.config.ts vite.preload.config.ts    \
                         vite.renderer.config.ts vite.tokens.config.ts \
                         vite.gallery.config.ts forge.config.ts}       \
                    file{electron/** material/**}
% update
{{
  diag vite ($<[1])

  rm -r -f $stage/electron $stage/material $stage/dist $stage/tools
  cp --no-cleanup -r $src_base/electron $stage/electron
  cp --no-cleanup -r $src_base/material $stage/material
  cp --no-cleanup $path($<[1]) $path($<[2]) $path($<[3]) $path($<[4]) \
    $path($<[5]) $path($<[6]) $path($<[7]) $stage

  $run --network=none $image npx vite build --logLevel=warn \
    --config vite.tokens.config.ts

  $run --network=none $image node tools/generate.js material/generated

  $run --network=none $image npx tsc -p .

  $run --network=none "--env=launcher_electron_gallery=$gallery" $image \
    npx vite build --logLevel=warn --config vite.main.config.ts

  $run --network=none $image npx vite build --logLevel=warn \
    --config vite.preload.config.ts

  $run --network=none $image npx vite build --logLevel=warn \
    --config vite.renderer.config.ts

  if $gallery
  {
    $run --network=none $image npx vite build --logLevel=warn \
      --config vite.gallery.config.ts
  }

  touch $path($>)
}}
% [diag=clean] clean
{{
  rm -r -f $stage/electron $stage/material $stage/dist $stage/tools \
    $stage/tsconfig.json $stage/forge.config.ts                     \
    $stage/vite.main.config.ts $stage/vite.preload.config.ts        \
    $stage/vite.renderer.config.ts $stage/vite.tokens.config.ts     \
    $stage/vite.gallery.config.ts                                   \
    $path($>) $path($>).d
}}

# Package the application for our target into out/. Note that Forge takes
# the Electron archive from the cache (see forge.config.ts).
#
# Windows and Mac OS only accept numeric versions in the executable metadata,
# so we pass the version without the pre-release part.
#
# The licenses of the third-party packages that the bundles contain require
# that a copy accompanies the distribution, so we copy each one into
# licenses/<package>/, which Forge places next to the archive.
#
# NOTE: remember to update the package list when the bundles start
#       containing another such package.
#
import addon = launcher%libs{launcher-node}

file{app.stamp}: file{bundle.stamp} $addon
% update
{{
  diag forge ($<[1])

  rm -r -f $out_base/out $stage/licenses
  cp --no-cleanup $path($<[1]) $stage/launcher.node

  for p: @fontsource-variable/inter @material-symbols/font-400 \
         lit lit-html lit-element @lit/reactive-element
  {
    mkdir --no-cleanup -p $stage/licenses/$p
    cp --no-cleanup $stage/node_modules/$p/LICENSE $stage/licenses/$p/LICENSE
  }

  v = "$version.major.$version.minor.$version.patch"

  $run --network=none "--env=launcher_electron_app_version=$v" $image \
    npx electron-forge package --platform=$platform --arch=$arch >-

  touch $path($>)
}}
% [diag=clean] clean
{{
  rm -r -f $out_base/out $stage/launcher.node $stage/licenses \
    $path($>) $path($>).d
}}
