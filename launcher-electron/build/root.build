# We need to configure the C++ module to obtain the target information (see
# buildfile).
#
using cxx.config

using in

# Podman program to run the JavaScript tools with (see buildfile).
#
config [path] config.launcher_electron.podman ?= podman

# Whether to build the component gallery into the application, which then
# shows it in place of the launcher if started with --gallery.
#
config [bool] config.launcher_electron.gallery ?= false
