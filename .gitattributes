# This is a good default: files that are auto-detected by git to be text are
# converted to the platform-native line ending (LF on Unix, CRLF on Windows)
# in the working tree and to LF in the repository.
#
* text=auto

# Use `eol=crlf` for files that should have the CRLF line ending both in the
# working tree (even on Unix) and in the repository.
#
#*.bat text eol=crlf

# Use `eol=lf` for files that should have the LF line ending both in the
# working tree (even on Windows) and in the repository.
#
#*.sh text eol=lf

# Use `binary` to make sure certain files are never auto-detected as text.
#
#*.png binary

# GitHub's Linguist, which does the syntax highlighting and the language
# statistics, has no build2 language and detects a buildfile as Ruby (the
# Buildfile of Buildr). So we keep the build2 files out of the statistics and
# highlight each one as the language that is closest to it, under both of the
# build2 naming schemes. The identity register is a manifest list as well.
#
buildfile    linguist-detectable=false linguist-language=Makefile
build2file   linguist-detectable=false linguist-language=Makefile
*.build      linguist-detectable=false linguist-language=Makefile
*.build2     linguist-detectable=false linguist-language=Makefile
testscript   linguist-detectable=false linguist-language=Shell
*.testscript linguist-detectable=false linguist-language=Shell
manifest     linguist-detectable=false linguist-language=YAML
*.manifest   linguist-detectable=false linguist-language=YAML
identities   linguist-detectable=false linguist-language=YAML

# The identity register is a manifest list of people, with no room for the
# SPDX header (see the headers tool).
#
identities -spdx

# The copy of the command line parser that the cli compiler generates and we
# keep in pregenerated/ (see launcher/launcher/buildfile). It carries no SPDX
# header, and GitHub collapses it in diffs and leaves it out of the language
# statistics.
#
**/pregenerated/** -spdx linguist-generated
