# These tests run the launcher itself.
#
define common: file
common{*}: extension = testscript

./: testscript{* -common} common{common} $launcher

testscript{*}: test = $launcher

# The launcher belongs to another package, so don't clean it through this
# dependency.
#
./: $launcher: clean = false
