# Each test uses its working directory as the installation root.

: migrate-clients
:
{{
  : x86
  :
  {
    touch --no-cleanup 'iw4x (x86).exe'

    $* migrate-clients &iw4x.exe

    test -f 'iw4x (x86).exe' == 1
  }

  : x64
  :
  {
    touch --no-cleanup 'iw4x (x64).exe'

    $* migrate-clients &'iw4x (mm).exe'

    test -f 'iw4x (x64).exe' == 1
  }

  : existing
  : Test keeping the legacy client if the current one already exists
  :
  {
    touch 'iw4x (x86).exe' iw4x.exe

    $* migrate-clients

    test -f 'iw4x (x86).exe'
  }
}}

: migrate-dlc
:
{{
  d = zone/iw4x/x86/dlc

  : move
  : Test moving the legacy copy of a missing DLC file to its destination
  :
  {
    mkdir -p zone/dlc
    echo 'legacy' >=zone/dlc/mp_farm.ff

    $* migrate-dlc $d/mp_farm.ff &!zone/dlc/mp_farm.ff &zone/iw4x/***

    test -f zone/dlc/mp_farm.ff == 1
    cat $d/mp_farm.ff >'legacy'
  }

  : existing
  : Test removing the legacy copy of a DLC file that is installed
  :
  {
    mkdir -p zone/dlc $d
    echo 'legacy' >=zone/dlc/mp_farm.ff
    echo 'current' >=$d/mp_farm.ff

    $* migrate-dlc $d/mp_farm.ff &!zone/dlc/mp_farm.ff

    test -f zone/dlc/mp_farm.ff == 1
    cat $d/mp_farm.ff >'current'
  }

  : read-only
  : Test failing if the legacy copy of an installed DLC file stays
  :
  : Note that root can remove files from a directory without the write
  : permission, so as root this test fails.
  :
  if ($cxx.target.class != 'windows')
  {
    mkdir -p zone/dlc $d
    echo 'legacy' >=zone/dlc/mp_farm.ff
    echo 'current' >=$d/mp_farm.ff

    chmod a-w zone/dlc

    $* migrate-dlc $d/mp_farm.ff 2>>~%EOE% != 0
      %error: unable to remove .+mp_farm\.ff, which the client would move over .+mp_farm\.ff at startup.*%
      EOE

    chmod u+w zone/dlc

    cat $d/mp_farm.ff >'current'
  }

  : unlisted
  : Test keeping the files of zone/dlc/ that the DLC doesn't install
  :
  {
    mkdir -p zone/dlc
    echo 'stock' >=zone/dlc/mp_crash.ff

    $* migrate-dlc $d/mp_farm.ff

    cat zone/dlc/mp_crash.ff >'stock'
  }

  : other
  : Test ignoring the DLC files that go elsewhere
  :
  {
    mkdir -p zone/dlc
    echo 'legacy' >=zone/dlc/iw_dlc3_00.iwd

    $* migrate-dlc main/iw4x/x86/iw_dlc3_00.iwd

    cat zone/dlc/iw_dlc3_00.iwd >'legacy'
  }
}}

: retire
:
{{
  : file
  :
  {
    touch --no-cleanup iw4x.dll

    $* retire iw4x.dll >'true' &cache/***

    test -f iw4x.dll == 1
    find cache/retired -type f >~'%cache[/\\]retired[/\\]\d+_\d+_iw4x\.dll%'
  }

  : missing
  : Test handling of a file that does not exist
  :
  $* retire iw4x.dll >'false' &cache/***
}}

: remove-retired
:
{
  mkdir --no-cleanup -p cache/retired
  touch --no-cleanup cache/retired/iw4x.dll

  $* remove-retired &cache/***

  test -f cache/retired/iw4x.dll == 1
}

: reset-cache
:
{{
  : new
  : Test creating the cache in an empty installation
  :
  {
    $* reset-cache '1.0.0' >'true' &cache/***

    test -f cache/iw4x.db
  }

  : same
  : Test keeping the cache of the same version
  :
  {
    $* reset-cache '1.0.0' >'true' &cache/***
    touch --no-cleanup cache/kept

    $* reset-cache '1.0.0' >'false'

    test -f cache/kept
  }

  : other
  : Test wiping the cache of another version
  :
  {
    $* reset-cache '1.0.0' >'true' &cache/***
    touch --no-cleanup cache/stale

    $* reset-cache '2.0.0' >'true'

    test -f cache/stale == 1
  }
}}
