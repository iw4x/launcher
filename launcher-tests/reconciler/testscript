# Blake3 hashes, as b3sum prints them, named after the contents they are
# for: the 4-byte 'data' and 'iw4x' and the empty input.
#
# Note that we write the contents without a newline since on Windows it
# would be written as CRLF and change the sizes and hashes.
#
d = 28a249c2e4d3a92bc0a16ed8f1b5cf83ca20415ee12e502b096624902bbc97bd
i = bd9c61ef91c497f6b581a75bb5c7b6ff97bd3d359dec332340f7eec95db6cf33
e = af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262

# Manifest of a rawfiles release with the client in release.zip. Note that
# the planner never plans update.json.
#
+cat <<"EOI" >=manifest.json
  {
    "archives": [
      {"name": "release.zip", "size": 100, "url": "u1", "blake3": "$e"},
      {"name": "iw_23.iwd", "size": 4, "url": "u2", "blake3": "$d"}
    ],
    "files": [
      {"path": "iw4x.exe", "size": 4, "blake3": "$i", "archive": "release.zip"},
      {"path": "data.txt", "size": 4, "blake3": "$d"},
      {"path": "update.json", "size": 2, "blake3": "$d"}
    ]
  }
  EOI

m = $~/manifest.json
iwd = main/iw4x/x86/iw_23.iwd

: plan
:
{{
  : missing
  : Test downloading everything into an empty installation
  :
  $* plan $m rawfiles 1.0.0 >>"EOO" &cache/***
    download release.zip 100 $e
    download $iwd 4 $d
    download data.txt 4 $d
    summary 3 108
    EOO

  : adopt
  : Test adopting the untracked files whose hashes match
  :
  {
    mkdir -p main/iw4x/x86
    cat <:'data' >=data.txt
    cat <:'iw4x' >=iw4x.exe
    cat <:'data' >=$iwd

    $* plan $m rawfiles 1.0.0 >'summary 0 0' &cache/***

    $* files rawfiles >>"EOO"
      data.txt 1.0.0 4 $d
      iw4x.exe 1.0.0 4 $i
      $iwd 1.0.0 4 $d
      EOO
  }

  : mismatch
  : Test downloading the files that differ from the manifest
  :
  {
    mkdir -p main/iw4x/x86
    cat <:'hello' >=data.txt
    cat <:'iw4y' >=iw4x.exe
    cat <:'iw4x' >=$iwd

    $* plan $m rawfiles 1.0.0 >>"EOO" &cache/***
      download release.zip 100 $e
      download $iwd 4 $d
      download data.txt 4 $d
      summary 3 108
      EOO

    $* files rawfiles
  }

  : tracked
  : Test trusting the tracked files of the version without hashing them
  :
  {
    cat <:'datx' >=data.txt

    $* track rawfiles 1.0.0 data.txt &cache/***
    $* plan $m rawfiles 1.0.0 >>"EOO"
      download release.zip 100 $e
      download $iwd 4 $d
      summary 2 104
      EOO
  }

  : version
  : Test rehashing the tracked files of another version
  :
  {
    cat <:'data' >=data.txt
    cat <:'iw4y' >=iw4x.exe

    $* track rawfiles 1.0.0 data.txt iw4x.exe &cache/***
    $* plan $m rawfiles 2.0.0 >>"EOO"
      download release.zip 100 $e
      download $iwd 4 $d
      summary 2 104
      EOO

    $* files rawfiles >>"EOO"
      data.txt 2.0.0 4 $d
      iw4x.exe 1.0.0 4 -
      EOO
  }
}}

: stat
:
{{
  : unknown
  :
  {
    cat <:'data' >=f

    $* stat f >'unknown' &cache/***
  }

  : valid
  :
  {
    cat <:'data' >=f

    $* track rawfiles 1.0.0 f &cache/***
    $* stat f >'valid'
  }

  : missing
  :
  {
    touch --no-cleanup f

    $* track rawfiles 1.0.0 f &cache/***
    rm f
    $* stat f >'missing'
  }

  : stale
  : Test detecting a modified file by its modification time
  :
  {
    cat <:'data' >=f
    $* set-mtime f

    $* track rawfiles 1.0.0 f &cache/***
    cat <:'iw4x' >=f
    $* stat f >'stale'
  }

  : size
  : Test detecting a modified file by its size only in the mixed strategy
  :
  {
    cat <:'data' >=f
    $* set-mtime f

    $* track rawfiles 1.0.0 f &cache/***
    cat <:'hello' >=f
    $* set-mtime f

    $* stat f       >'valid'
    $* stat f mixed >'stale'
  }
}}

: clean
: Test forgetting the tracked files that are no longer in the manifest
:
{
  mkdir -p main/iw4x/x86
  cat <:'data' >=data.txt
  cat <:'iw4x' >=iw4x.exe
  cat <:'data' >=old.txt
  cat <:'data' >=$iwd

  $* track rawfiles 1.0.0 data.txt iw4x.exe old.txt $iwd &cache/***
  $* clean $m rawfiles >'old.txt'

  $* files rawfiles >>"EOO"
    data.txt 1.0.0 4 -
    iw4x.exe 1.0.0 4 -
    $iwd 1.0.0 4 -
    EOO
}

: outdated
:
{
  $* outdated client v1.0.0 >'true' &cache/***
  $* stamp client v1.0.0
  $* outdated client v1.0.0 >'false'
  $* outdated client v1.1.0 >'true'
  $* outdated rawfiles v1.0.0 >'true'
}
