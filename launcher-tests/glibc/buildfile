# Test that the launcher stays within the glibc floor (see glibc.cxx in the
# launcher package), which only exists for glibc on x86_64.
#
./: testscript $launcher: \
  include = ($cxx.target.system == 'linux-gnu' && $cxx.target.cpu == 'x86_64')

testscript{*}: test = $launcher

# The launcher belongs to another package, so don't clean it through this
# dependency.
#
./: $launcher: clean = false
