# Each test lays out a Steam installation with a Proton directory, holding
# the proton script, for every release that it lists.

: numeric
: Test preferring the newest numbered release
:
{
  for n: 'Proton 9.0' 'Proton 10.0'
  {
    mkdir -p "steamapps/common/$n"
    touch "steamapps/common/$n/proton"
  }

  $* versions $~ >>EOO
    Proton 10.0
    Proton 9.0
    EOO
}

: hotfix
: Test preferring numbered releases to Proton Hotfix
:
{
  for n: 'Proton Hotfix' 'Proton 9.0'
  {
    mkdir -p "steamapps/common/$n"
    touch "steamapps/common/$n/proton"
  }

  $* versions $~ >>EOO
    Proton 9.0
    Proton Hotfix
    EOO
}

: experimental
: Test preferring Proton Experimental to numbered releases
:
{
  for n: 'Proton 10.0' 'Proton - Experimental'
  {
    mkdir -p "steamapps/common/$n"
    touch "steamapps/common/$n/proton"
  }

  $* versions $~ >>EOO
    Proton - Experimental
    Proton 10.0
    EOO
}

: helper-file
: Test the names that the Steam helper's release assets are installed under
:
{{
  $* helper-file steam.exe       >'iw4x-steam.exe'  : probe
  $* helper-file steam_api64.dll >'steam_api64.dll' : api
  $* helper-file README.md                          : other
}}

: ghost-result
: Test the outcomes that the exit status of the Steam probe reports
:
{{
  $* ghost-result 0 >'steam-running'     : success
  $* ghost-result 1 >'steam-not-running' : failure
  $* ghost-result 3 >'steam-not-running' : proton
}}
