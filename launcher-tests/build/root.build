# Suppress warnings coming from external libraries.
#
cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx

# Whether we test an installed launcher, as opposed to one from a build.
#
installed = false

if ($build.mode != 'skeleton')
{
  # Import the launcher executable, which the functional tests run, and the
  # library with everything except its main(), which the test drivers link.
  # Note that the launcher package doesn't install the library, so the
  # import only finds it in a build. Which is also how we tell an installed
  # launcher.
  #
  import! [metadata] launcher = launcher%exe{iw4x-launcher}
  import? libs = launcher%liba{launcher}

  installed = ($libs == [null])
}

# Disable "unknown pragma" warnings for the ODB pragmas in the launcher's
# database classes, which some test drivers include.
#
switch $cxx.class
{
  case 'msvc'
    cxx.coptions += /wd4068

  case 'gcc'
    cxx.coptions += -Wno-unknown-pragmas
}

# Every exe{} in this project is by default a test.
#
exe{*}: test = true

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
