include ../launcher/

import! [metadata, rule_hint=cxx.link] \
  libs = libnode-api-headers%lib{node-api-headers}

tclass = $cxx.target.class
tsys   = $cxx.target.system

windows = ($tclass == 'windows')
mingw   = ($tsys == 'mingw32')
msvc    = ($tsys == 'win32-msvc')

# Node.js addon that launcher-electron loads into its main process.
#
# Note that it is only ever loaded at runtime (thus libs{}) and links the
# same objects as the launcher executable (see ../launcher/buildfile).
#
libs{launcher-node}: cxx{** -delay-load-windows} \
                     ../launcher/libul{launcher} $libs

libs{launcher-node}: cxx{delay-load-windows}: include = $windows

# Don't install the addon since launcher-electron ships it as part of its
# application package.
#
libs{launcher-node}: install = false

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

# Electron 44 embeds Node.js 24, which provides Node-API version 10.
#
# NOTE: remember to update this when upgrading Electron in
#       launcher-electron/package.json.
#
cxx.poptions += -DNAPI_VERSION=10

# Node-API import library.
#
# The Node-API functions are provided by the executable that loads the addon.
# On Linux they can stay unresolved by default while on Mac OS we have to ask
# the linker for this. On Windows we produce the import library for node.exe
# from the module definition file and delay-load node.exe. The delay-load
# hook then redirects it to the process executable (see
# delay-load-windows.cxx for details).
#
# Note that we declare both import libraries (and their recipes) in every
# configuration and let include pick the one we need. This way the build
# graph is the same regardless of the target.
#
node_api_def = [path] $($libs: libnode_api_headers.node_api_def)

# Note that the file is in the dependency's source directory and so has to be
# declared explicitly.
#
def{$node_api_def}:

libs{launcher-node}: file{node.lib}:  include = ($msvc  ? adhoc : false)
libs{launcher-node}: file{libnode.a}: include = ($mingw ? adhoc : false)

switch $tclass, $tsys
{
  case 'macos'
    libs{launcher-node}: cxx.loptions += -Wl,-undefined,dynamic_lookup

  case 'windows', 'win32-msvc'
  {
    switch $cxx.target.cpu
    {
      case 'x86_64'
        machine = x64
      case 'aarch64'
        machine = arm64
      default
        fail "unsupported target cpu $cxx.target.cpu"
    }

    libs{launcher-node}:
    {
      cxx.loptions += ($cxx.class == 'msvc'    \
                       ? /DELAYLOAD:node.exe   \
                       : -Wl,/DELAYLOAD:node.exe)
      cxx.libs += $out_base/node.lib delayimp.lib
    }
  }

  case 'windows', 'mingw32'
  {
    switch $cxx.target.cpu
    {
      case 'x86_64'
        machine = i386:x86-64
      case 'aarch64'
        machine = arm64
      default
        fail "unsupported target cpu $cxx.target.cpu"
    }

    # Derive dlltool from the binutils pattern, if any (see the bin module
    # for details).
    #
    if ($bin.pattern == [null])
      dlltool = dlltool
    elif $regex.match($bin.pattern, '.*\*.*')
      dlltool = $regex.replace($bin.pattern, '\*', 'dlltool')
    else
      dlltool = "$(bin.pattern)dlltool"

    # Note that the delay-load helper is part of the MinGW runtime (see
    # delayimp.lib above).
    #
    libs{launcher-node}: cxx.libs += $out_base/libnode.a

    # Link the GCC runtime statically since the application package has no
    # copy of its DLLs and Windows doesn't provide them.
    #
    # Note that libstdc++ also depends on winpthreads, which the compiler
    # driver links after our libraries, thus --whole-archive.
    #
    libs{launcher-node}:
    {
      cxx.loptions += -static-libstdc++ -static-libgcc
      cxx.libs += -Wl,-Bstatic,--whole-archive -lwinpthread \
                  -Wl,--no-whole-archive,-Bdynamic
    }
  }
}

# Note that lib.exe also produces the exports file, which we don't need.
#
<file{node.lib} file{node.exp}>: def{$node_api_def}
%
if $msvc
{{
  diag lib ($<)

  $bin.ar.path /NOLOGO /MACHINE:$machine /NAME:node.exe \
    "/DEF:$path($<)" "/OUT:$path($>[0])" >-
}}

file{libnode.a}: def{$node_api_def}
%
if $mingw
{{
  diag dlltool ($<)

  $dlltool --machine $machine --input-def $path($<) \
    --dllname node.exe --output-delaylib $path($>)
}}
