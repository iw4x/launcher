./: testscript

# Pass the launcher version from its metadata (testscript cannot look up
# target-specific variables).
#
testscript{*}: launcher_version = $($launcher: launcher.version)

# Note: avoid cleaning exe{launcher} through this dependency.
#
./: $launcher: clean = false
