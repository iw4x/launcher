# Note that only the development build regenerates the command line parser
# and the man pages from launcher.cli, which requires the cli compiler. The
# consumption build uses the pregenerated versions that we keep in the
# repository (see launcher/buildfile for details).
#
config [bool] config.launcher.develop ?= false

develop = $config.launcher.develop

define cli: file
cli{*}: extension = cli

# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx

# Specify the test target for cross-testing.
#
test.target = $cxx.target
