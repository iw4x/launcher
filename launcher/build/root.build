# Development build. In this mode we regenerate the files kept in
# launcher/pregenerated/ and update the copies if they have changed. In the
# consumption build we compile the copies as they are, so that only
# development requires the code generators.
#
config [bool] config.launcher.develop ?= false

develop = $config.launcher.develop

# Suppress warnings coming from external libraries.
#
cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx

# The maintainer scripts in etc/ are bash scripts.
#
using bash

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

if ($cxx.target.system == 'win32-msvc')
  cxx.poptions += -D_CRT_SECURE_NO_WARNINGS -D_SCL_SECURE_NO_WARNINGS

if ($cxx.class == 'msvc')
  cxx.coptions += /wd4251 /wd4275 /wd4800
