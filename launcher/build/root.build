# The development build regenerates the command line parser from its .cli
# definition with the cli compiler. Everyone else uses the copy that we keep
# in pregenerated/, so that only the development build requires cli (see
# launcher/buildfile for details).
#
config [bool] config.launcher.develop ?= false

develop = $config.launcher.develop

define cli: file
cli{*}: extension = cli

# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
