# Whether to regenerate the command line parser and man pages from
# launcher.cli (note: requires the cli compiler). Otherwise, use the pregenerated
# versions (see launcher/buildfile for details).
#
config [bool] config.launcher.develop ?= false

develop = $config.launcher.develop

define cli: file
cli{*}: extension = cli

# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx
