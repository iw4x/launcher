define xhtml: doc
xhtml{*}: extension = xhtml

define pdf: doc
pdf{*}: extension = pdf

# Note that the prologues and epilogues are only prerequisites in the
# development build so list them here to also distribute them in the
# consumption build.
#
./: file{man-*}

# Man pages.
#
# Similar to the options parser (see ../launcher/buildfile), we keep the man
# pages generated from ../launcher/launcher.cli in pregenerated/ and only
# regenerate them in the development build.

## Consumption build ($develop == false).
#

# Use pregenerated versions in the consumption build.
#
./: pregenerated/{man1 xhtml}{*}: include = (!$develop)

# Distribute pregenerated versions only in the consumption build.
#
pregenerated/{man1 xhtml}{*}: dist = (!$develop)

#
##

## Development build ($develop == true).
#

./: {man1 xhtml}{launcher}: include = $develop

if $develop
{
  import! [metadata] cli = cli%exe{cli}

  # Leave the snapshot part out of the documented version. Otherwise every
  # commit would change the pages and make the pregenerated versions stale.
  #
  doc_version = [string] "$version.major.$version.minor.$version.patch"

  if $version.pre_release
    doc_version += "-$version.pre_release_string"

  # NOTE: remember to update the date when preparing a release.
  #
  doc_date = 'October 2026'

  man_options = -v project='launcher'           \
                -v version="$doc_version"       \
                -v date="$doc_date"             \
                -v copyright='the IW4x authors' \
                --suppress-undocumented
}

# In the development build distribute regenerated versions, remapping their
# locations to the paths of the pregenerated versions (which are only
# distributed in the consumption build; see above). This way we make sure that
# the distributed files are always up-to-date.
#
{man1 xhtml}{launcher}: dist = ($develop ? pregenerated/ : false)

man1{launcher}: ../launcher/cli{launcher}           \
                file{man-prologue.1 man-epilogue.1} \
                $cli
%
if $develop
{{
  diag 'cli --man' ($<[0]) -> $>

  $cli --generate-man $man_options      \
       --man-prologue-file $path($<[1]) \
       --man-epilogue-file $path($<[2]) \
       --stdout $path($<[0]) >$path($>)

  # If the result differs from the pregenerated version (or there is none
  # yet), copy it over (see ../launcher/buildfile for why --no-cleanup).
  #
  p = $src_base/pregenerated/launcher.1

  if test -f $p && diff $p $path($>) >-
    exit

  mkdir --no-cleanup -p $src_base/pregenerated
  cp --no-cleanup $path($>) $p
}}

xhtml{launcher}: ../launcher/cli{launcher}                   \
                 file{man-prologue.xhtml man-epilogue.xhtml} \
                 $cli
%
if $develop
{{
  diag 'cli --html' ($<[0]) -> $>

  $cli --generate-html $man_options      \
       --html-prologue-file $path($<[1]) \
       --html-epilogue-file $path($<[2]) \
       --stdout $path($<[0]) >$path($>)

  p = $src_base/pregenerated/launcher.xhtml

  if test -f $p && diff $p $path($>) >-
    exit

  mkdir --no-cleanup -p $src_base/pregenerated
  cp --no-cleanup $path($>) $p
}}

#
##

# PDF.
#
# This case is slightly more involved because we make the rendering of the
# PDF optional and also don't keep the result in the repository (each
# rendering embeds its creation date). Specifically:
#
# 1. In the consumption build we will install/redistribute the PDF if present.
#
# 2. In the development build we will render the PDF from the man page if we
#    are able to import groff and ps2pdf, issuing a warning otherwise.

## Consumption build ($develop == false).
#

# Use the pregenerated version, if present, in the consumption build.
#
./: pregenerated/pdf{*}: include = (!$develop)

# Distribute the pregenerated version only in the consumption build.
#
pregenerated/pdf{*}: dist = (!$develop)

#
##

## Development build ($develop == true).
#

render = false

if $develop
{
  # Import the groff and ps2pdf programs from the system, if available.
  #
  import? groff  = groff%exe{groff}
  import? ps2pdf = ps2pdf%exe{ps2pdf}

  render = ($groff != [null] && $ps2pdf != [null])

  if! $render
    warn "groff and/or ps2pdf are not available, not generating launcher.pdf"
}

./: pdf{launcher}: include = $render

# As above.
#
pdf{launcher}: dist = ($render ? pregenerated/ : false)

pdf{launcher}: man1{launcher} $groff $ps2pdf
%
if $render
{{
  diag ps2pdf ($<[0]) -> $>

  $groff -man -Tps $path($<[0]) | $ps2pdf - $path($>)

  # Also copy the result to pregenerated/ for consistency with the
  # distributed source tree (see ../launcher/buildfile for why
  # --no-cleanup).
  #
  mkdir --no-cleanup -p $src_base/pregenerated
  cp --no-cleanup $path($>) $src_base/pregenerated/launcher.pdf
}}

