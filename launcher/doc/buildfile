define xhtml: doc
xhtml{*}: extension = xhtml

define pdf: doc
pdf{*}: extension = pdf

# The prologues and epilogues are only prerequisites in the development build,
# so we list them here to distribute them in every build.
#
./: file{man-*}

# Man pages.
#
# The man page and its XHTML version are generated from the command line
# definition (../launcher/launcher.cli) by the cli compiler. As with the
# command line parser (see ../launcher/buildfile), the development build
# regenerates them and keeps the copy in pregenerated/ up to date, which the
# consumption build uses.

## Consumption build ($develop == false).
#

# Use the pregenerated pages.
#
./: pregenerated/{man1 xhtml}{*}: include = (!$develop)

# Distribute the pregenerated pages only in the consumption build.
#
pregenerated/{man1 xhtml}{*}: dist = (!$develop)

#
##

## Development build ($develop == true).
#

./: {man1 xhtml}{launcher}: include = $develop

if $develop
{
  import! [metadata] cli = cli%exe{cli}

  # The version that the pages document, without the snapshot part. With the
  # snapshot part every commit would change the pages and leave the copy in
  # pregenerated/ out of date.
  #
  doc_version = [string] "$version.major.$version.minor.$version.patch"

  if $version.pre_release
    doc_version += "-$version.pre_release_string"

  # The month and year of the release that the pages document. We change it
  # together with the version, when we prepare a release.
  #
  doc_date = 'October 2026'

  man_options = -v project='launcher'           \
                -v version="$doc_version"       \
                -v date="$doc_date"             \
                -v copyright='the IW4x authors' \
                --suppress-undocumented
}

# In the development build we distribute the regenerated pages in place of the
# pregenerated ones (which are only distributed in the consumption build, see
# above), remapping them to the pregenerated location, so that the
# distributed pages are always up to date.
#
{man1 xhtml}{launcher}: dist = ($develop ? pregenerated/ : false)

man1{launcher}: ../launcher/cli{launcher}           \
                file{man-prologue.1 man-epilogue.1} \
                $cli
%
if $develop
{{
  diag 'cli --man' ($<[0]) -> $>

  $cli --generate-man $man_options      \
       --man-prologue-file $path($<[1]) \
       --man-epilogue-file $path($<[2]) \
       --stdout $path($<[0]) >$path($>)

  # If the result differs from the pregenerated copy (or there is no copy
  # yet), update the copy. See ../launcher/buildfile for the reason behind
  # --no-cleanup.
  #
  p = $src_base/pregenerated/launcher.1

  if test -f $p && diff $p $path($>) >-
    exit

  mkdir --no-cleanup -p $src_base/pregenerated
  cp --no-cleanup $path($>) $p
}}

xhtml{launcher}: ../launcher/cli{launcher}                   \
                 file{man-prologue.xhtml man-epilogue.xhtml} \
                 $cli
%
if $develop
{{
  diag 'cli --html' ($<[0]) -> $>

  $cli --generate-html $man_options      \
       --html-prologue-file $path($<[1]) \
       --html-epilogue-file $path($<[2]) \
       --stdout $path($<[0]) >$path($>)

  p = $src_base/pregenerated/launcher.xhtml

  if test -f $p && diff $p $path($>) >-
    exit

  mkdir --no-cleanup -p $src_base/pregenerated
  cp --no-cleanup $path($>) $p
}}

#
##

# PDF.
#
# The PDF version of the man page is rendered with Ghostscript's ps2pdf from
# the PostScript that groff produces. The development build renders it if
# both programs are installed. Each rendering records its creation date, so
# we don't commit the result. We still copy it to pregenerated/ and
# distribute it from there, which lets the consumption build of a
# distribution install it.

## Consumption build ($develop == false).
#

# Use the pregenerated PDF, if there is one.
#
./: pregenerated/pdf{*}: include = (!$develop)

pregenerated/pdf{*}: dist = (!$develop)

#
##

## Development build ($develop == true).
#

render = false

if $develop
{
  import? groff  = groff%exe{groff}
  import? ps2pdf = ps2pdf%exe{ps2pdf}

  render = ($groff != [null] && $ps2pdf != [null])

  if! $render
    warn "groff and/or ps2pdf are not available, not generating launcher.pdf"
}

./: pdf{launcher}: include = $render

pdf{launcher}: dist = ($render ? pregenerated/ : false)

pdf{launcher}: man1{launcher} $groff $ps2pdf
%
if $render
{{
  diag ps2pdf ($<[0]) -> $>

  $groff -man -Tps $path($<[0]) | $ps2pdf - $path($>)

  # Note that the pregenerated copy may not exist yet (see above for the
  # reason behind --no-cleanup).
  #
  mkdir --no-cleanup -p $src_base/pregenerated
  cp --no-cleanup $path($>) $src_base/pregenerated/launcher.pdf
}}

