include <cstdint>; // std::uint64_t
include <string>;
include <vector>;

include <launcher/arch/arch-types.hxx>;

namespace launcher
{
  class options
  {
    bool --help
    {
      "Show this help message and exit."
    };

    bool --version
    {
      "Show version information and exit."
    };

    // build2 metadata export protocol.
    //
    bool --build2-metadata
    {
      "Print the build2 metadata and exit."
    };

    // Common options.
    //
    bool --prerelease
    {
      "Opt-in to pre-release (beta) updates. Use this to test upcoming
       features before they are marked as stable."
    };

    std::size_t --jobs | -j = 99
    {
      "<num>",
      "The number of parallel download jobs to run. Defaults to 99."
    };

    launcher::architecture --arch
    {
      "<arch>",
      "The IW4x client to launch, either \cb{x86} or \cb{x64}.

       \cb{x86} is built around community-hosted dedicated servers. Each
       server can have its own rules and mods. \cb{x64} is built around
       matchmaking, with friends and parties available directly in the
       client.

       Both are installed next to each other regardless, so this only selects
       which of the two to start. If it is not specified the launcher asks,
       which is what the shortcuts it installs are for: each passes the
       architecture it stands for."
    };

    std::string --game-exe
    {
      "<file>",
      "The game executable to launch. Defaults to the executable belonging to
       the selected \cb{--arch}."
    };

    std::vector<std::string> --game-args
    {
      "<arg>",
      "Additional arguments to pass to the game executable. Can be specified
       multiple times."
    };

    bool --force-steam-runtime
    {
      "Use the Steam Linux Runtime container instead of the standalone Proton."
    };

    bool --no-self-update
    {
      "Skip the automatic launcher self-update check. Use this if you want to
       manage launcher updates manually."
    };

    bool --self-update-only
    {
      "Only check for and apply launcher updates, then exit. Does not update
       game files."
    };

    bool --skip-launch
    {
      "Skip launching the game after updating/installing. The launcher will
       perform all update operations but exit without starting the game."
    };

    bool --no-shortcuts
    {
      "Skip the shortcut refresh. The launcher normally rewrites its desktop
       and application menu entries on every run, and adds both clients to
       Steam's library as non-Steam games, so that they keep working after
       the installation has been moved."
    };

    bool --skip-remote
    {
      "Skip all remote checks and file reconciliation. The launcher will
       attempt to launch the game executable directly without contacting
       GitHub and without verifying local files."
    };

    std::string --proxy
    {
      "<url>",
      "Route all HTTP/HTTPS traffic through the specified proxy. Accepts
       \cb{http://host:port}, \cb{https://host:port}, and
       \cb{socks5://host:port} URLs. For SOCKS5 proxies that require
       authentication use \cb{socks5://user:pass@host:port}."
    };

    std::string --wait-pid
    {
      "<pid>",
      "Wait for the process with the given id to exit before updating files.
       Used when the launcher is started by the game so file replacement does
       not race the still-running process, which Windows keeps locked while in
       use."
    };
  };
}
