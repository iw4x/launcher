intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libboost-asio%lib{boost_asio}
import intf_libs += libboost-beast%lib{boost_beast}
import intf_libs += libboost-json%lib{boost_json}
import intf_libs += libboost-system%lib{boost_system}
import intf_libs += libssl%lib{ssl}
import intf_libs += libcrypto%lib{crypto}
import intf_libs += libftxui%lib{ftxui-component}
import intf_libs += libftxui%lib{ftxui-dom}
import intf_libs += libftxui%lib{ftxui-screen}
import intf_libs += libodb%lib{odb}
import intf_libs += libodb-sqlite%lib{odb-sqlite}
import intf_libs += libquill%lib{quill}

import impl_libs += libboost-process%lib{boost_process}
import impl_libs += libblake3%lib{blake3}
import impl_libs += libminiz%lib{miniz}

tclass = $cxx.target.class
tsys   = $cxx.target.system
tcpu   = $cxx.target.cpu

linux   = ($tclass == 'linux')
windows = ($tclass == 'windows')

glibc = ($linux && $tcpu == 'x86_64')

define cli: file
cli{*}: extension = cli

define png: file
png{*}: extension = png

# Everything except main() goes into a static library that the launcher
# links, as do the test drivers in the launcher-tests package. Note that it
# has to be a real library since a utility library cannot be imported by
# another project.
#
./: exe{iw4x-launcher}: cxx{launcher} liba{launcher}

liba{launcher}: {hxx ixx txx cxx}{** -launcher                   \
                                     -launcher-steam-proton      \
                                     -steam/steam-proton         \
                                     -shortcut/shortcut-writer-* \
                                     -launcher-options           \
                                     -cache/cache-types-odb      \
                                     -glibc*                     \
                                     -version                    \
                                     -pregenerated/**}           \
                hxx{version}                                     \
                $impl_libs $intf_libs

# Proton only exists on Linux and each platform has its own way of writing
# shortcuts.
#
liba{launcher}: {hxx cxx}{launcher-steam-proton steam/steam-proton}: \
  include = $linux

liba{launcher}: shortcut/cxx{shortcut-writer-linux}:   include = $linux
liba{launcher}: shortcut/cxx{shortcut-writer-windows}: include = $windows

# The glibc floor keeps the Linux launcher within the glibc that the oldest
# supported host provides (see glibc.cxx). Its definitions have to end up in
# the launcher, so we only build them into the executable.
#
exe{iw4x-launcher}: {hxx cxx}{glibc} hxx{glibc-x86_64}: include = $glibc

# We ship the Linux launcher on its own to any host, so it carries the C++
# runtime and links our dependencies statically.
#
if $glibc
{
  bin.exe.lib = static shared

  exe{iw4x-launcher}: cxx.loptions += -static-libstdc++ -static-libgcc
}

# Link the library to the same variants of our dependencies as the launcher.
# Otherwise the launcher could end up with both the static and the shared
# variant of the same library.
#
bin.liba.lib = $bin.exe.lib

# Target metadata, see also --build2-metadata in launcher.cxx.
#
exe{iw4x-launcher}:
{
  export.metadata = 1 launcher
  launcher.name = [string] iw4x-launcher
  launcher.version = [string] $version
  launcher.checksum = [string] $version
}

hxx{version}: in{version} $src_root/manifest

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

# Target Windows 10, the oldest version that Steam supports, and keep
# <windows.h> from defining the min() and max() macros. Note that Asio
# expects _WIN32_WINNT to be the same in every translation unit that
# includes it, which is why we also export these options.
#
windows_poptions =

if $windows
  windows_poptions = -DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00 -DNOMINMAX

cxx.poptions += $windows_poptions

# Every translation unit of the launcher binds its glibc references to the
# floor (see glibc.hxx).
#
if $glibc
  cxx.poptions += -include "$src_base/glibc.hxx"

# Except for the definitions that keep the launcher within the floor, which
# define some of the symbols that the bindings bind (see glibc.cxx).
#
obje{glibc}: cxx.poptions = "-I$out_root" "-I$src_root"

# Our Asio and Beast heavy translation units can exceed the section limit of
# the default COFF object format.
#
switch $tsys
{
  case 'win32-msvc'
    cxx.coptions += /bigobj

  case 'mingw32'
    cxx.coptions += -Wa,-mbig-obj
}

# Open every log category to the full trace range in the development build
# (see launcher-log.cxx for details).
#
if $develop
  obj{launcher-log}: cxx.poptions += -DLAUNCHER_DEVELOP

# Additional system libraries.
#
switch $tclass, $tsys
{
  case 'windows', 'mingw32'
    cxx.libs += -ladvapi32 -lole32 -luuid -lshell32

  case 'windows'
    cxx.libs += advapi32.lib ole32.lib uuid.lib shell32.lib
}

# Export options.
#
# Note that we export the implementation dependencies as well since
# otherwise the test drivers, which import this library, don't get the
# run-time search paths of their shared variants.
#
liba{launcher}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root" $windows_poptions
  cxx.export.libs = $intf_libs $impl_libs
}

# Generated code.
#
# We keep a copy of every generated file in pregenerated/, which is what the
# consumption build compiles. The development build regenerates the files
# and, if the result differs from the copy, updates the copy. It also
# distributes the regenerated files in place of the copies, so that the
# distribution is always up to date.
#
liba{launcher}: pregenerated/{hxx ixx cxx}{**}: include = (!$develop)

if! $develop
{
  cxx.poptions =+ "-I($src_base/pregenerated)" # Note: must come first.
  liba{launcher}: cxx.export.poptions =+ "-I($src_base/pregenerated)"
}

pregenerated/{hxx ixx cxx}{*}: dist = (!$develop)

if $develop
{
  import! [metadata] cli = cli%exe{cli}
  import! [metadata] odb = odb%exe{odb}
}

# Command line options parser.
#
liba{launcher}: {hxx ixx cxx}{launcher-options}: include = $develop

<{hxx ixx cxx}{launcher-options}>: cli{launcher} $cli
{
  dist = ($develop ? pregenerated/launcher/ : false)
}
%
if $develop
{{
  t = $path($>[0]).t

  depdb dyndep --byproduct --file $t

  options = -I $src_root --std c++11                                   \
            --include-with-brackets --include-prefix launcher          \
            --guard-prefix LAUNCHER --cli-namespace launcher::cli      \
            --generate-specifier --generate-file-scanner               \
            --suppress-undocumented --exclude-base                     \
            --cxx-prologue "#include <launcher/arch/arch-parsers.hxx>" \
            --output-suffix -options

  diag cli ($<[0]) -> $>

  $cli $options --generate-dep --dep-file $t -o $out_base $path($<[0])

  # If the result differs from the pregenerated copy, update the copy.
  #
  d = [dir_path] $src_base/pregenerated/launcher

  if diff $d/launcher-options.hxx $path($>[0]) >- && \
     diff $d/launcher-options.ixx $path($>[1]) >- && \
     diff $d/launcher-options.cxx $path($>[2]) >-
    exit

  cp $path($>[0]) $d/launcher-options.hxx
  cp $path($>[1]) $d/launcher-options.ixx
  cp $path($>[2]) $d/launcher-options.cxx
}}

# Database support code.
#
# The ODB compiler needs the preprocessor options of the ODB runtime, which
# we get from this utility library.
#
liba{launcher}: cache/{hxx ixx cxx}{cache-types-odb}: include = $develop

[rule_hint=cxx] cache/libue{cache-types-meta}: $intf_libs

<cache/{hxx ixx cxx}{cache-types-odb}>: cache/hxx{cache-types}        \
                                        cache/libue{cache-types-meta} \
                                        $odb
{
  dist = ($develop ? ../pregenerated/launcher/cache/ : false)
}
%
if $develop
{{
  pops = $cxx.lib_poptions($<[1])

  depdb hash $pops

  options = --std c++17 --database sqlite -I $src_root              \
            --include-with-brackets --include-prefix launcher/cache \
            --guard-prefix LAUNCHER_CACHE                           \
            --generate-schema --generate-query

  diag odb ($<[0]) -> $>

  $odb $options $pops --output-dir $out_base/cache/ $path($<[0])

  # As above.
  #
  d = [dir_path] $src_base/pregenerated/launcher/cache

  if diff $d/cache-types-odb.hxx $path($>[0]) >- && \
     diff $d/cache-types-odb.ixx $path($>[1]) >- && \
     diff $d/cache-types-odb.cxx $path($>[2]) >-
    exit

  cp $path($>[0]) $d/cache-types-odb.hxx
  cp $path($>[1]) $d/cache-types-odb.ixx
  cp $path($>[2]) $d/cache-types-odb.cxx
}}

# Shortcut artwork.
#
# We compile each image into the launcher as the array initializer that
# xxd -i produces, one header per image. We embed the images this way since
# not every compiler that we build with supports #embed.
#
for i: shortcut/artwork/png{*}
{
  n = $name($i)

  liba{launcher}: shortcut/artwork/hxx{$n-png}: include = $develop

  shortcut/artwork/hxx{$n-png}: shortcut/artwork/png{$n}
  {
    dist = ($develop ? ../../pregenerated/launcher/shortcut/artwork/ : false)
  }
}

hxx{~'/(.+)-png/'}: png{~'/\1/'}
%
if $develop
{{
  diag xxd ($<[0]) -> $>

  h = $path($>[0])

  # Read the image from stdin so that xxd only writes the array initializer,
  # without a variable named after the input path.
  #
  xxd -i <=$path($<[0]) >=$h

  # As above.
  #
  d = [dir_path] $src_base/pregenerated/$leaf($directory($h), $out_root)

  if diff $d/$leaf($h) $h >-
    exit

  cp $h $d/$leaf($h)
}}
