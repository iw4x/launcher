libs =

./: exe{launcher}: cxx{launcher} libul{launcher}

# Build the executable from a utility library that the Node addon (see
# ../node/) also links. Note: main() must stay out of it since utility
# libraries are linked whole.
#
libul{launcher}: {hxx ixx txx cxx}{** -launcher          \
                                      -version           \
                                      -launcher-options  \
                                      -pregenerated/**}  \
                 hxx{version} $libs

# Target metadata, see also --build2-metadata in launcher.cxx.
#
# Note that launcher does not query any environment variables.
#
exe{launcher}:
{
  export.metadata = 1 launcher
  launcher.name     = [string] launcher
  launcher.version  = [string] $version
  launcher.checksum = [string] $version
}

hxx{version}: in{version} $src_root/manifest

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

# Link the Windows console support of std::print(), which MinGW GCC keeps in
# the separate stdc++exp library.
#
if ($cxx.target.system == 'mingw32' && $cxx.id == 'gcc')
  cxx.libs += -lstdc++exp

# Generated options parser.
#
# We keep the generated options parser in pregenerated/ so that only the
# development build requires the cli compiler.
#
# In the consumption build ($config.launcher.develop == false) we just use
# this pregenerated source code. In the development build
# ($config.launcher.develop == true) we regenerate the parser from
# launcher.cli and, if the result differs, copy it over to pregenerated/.

## Consumption build ($develop == false).
#

# Use pregenerated versions in the consumption build.
#
libul{launcher}: pregenerated/{hxx cxx}{**}: include = (!$develop)

if! $develop
  cxx.poptions =+ "-I($src_base/pregenerated)" # Note: must come first.

# Distribute pregenerated versions only in the consumption build.
#
pregenerated/{hxx cxx}{**}: dist = (!$develop)

#
##

## Development build ($develop == true).
#

libul{launcher}: {hxx cxx}{launcher-options}: include = $develop

if $develop
  import! [metadata] cli = cli%exe{cli}

# In the development build distribute regenerated {hxx cxx}{launcher-options},
# remapping their locations to the paths of the pregenerated versions (which
# are only distributed in the consumption build; see above). This way we make
# sure that the distributed files are always up-to-date.
#
<{hxx cxx}{launcher-options}>: cli{launcher} $cli
{
  dist = ($develop ? pregenerated/launcher/ : false)
}
%
if $develop
{{
  options = --std c++14                            \
            --include-with-brackets                \
            --include-prefix launcher              \
            --guard-prefix LAUNCHER                \
            --cli-namespace launcher::cli          \
            --generate-parse                       \
            --generate-specifier                   \
            --suppress-inline                      \
            --suppress-undocumented                \
            --long-usage                           \
            --option-length 11                     \
            --page-usage 'launcher::print_$name$_' \
            --output-suffix -options

  diag cli ($<[0]) -> $>

  $cli $options -o $out_base $path($<[0])

  # If the result differs from the pregenerated version (or there is none
  # yet), copy it over.
  #
  d = [dir_path] $src_base/pregenerated/launcher

  if test -f $d/launcher-options.hxx              && \
     test -f $d/launcher-options.cxx              && \
     diff $d/launcher-options.hxx $path($>[0]) >- && \
     diff $d/launcher-options.cxx $path($>[1]) >-
    exit

  # Note: the pregenerated versions may not exist yet, thus --no-cleanup is
  # required for the mkdir and cp builtin calls (newly created filesystem
  # entries are otherwise removed once the recipe completes).
  #
  mkdir --no-cleanup -p $d

  cp --no-cleanup $path($>[0]) $d/launcher-options.hxx
  cp --no-cleanup $path($>[1]) $d/launcher-options.cxx
}}

