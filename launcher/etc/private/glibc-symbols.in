#!/usr/bin/env bash

# Copyright (c) the IW4x authors (see the AUTHORS file).
# SPDX-License-Identifier: GPL-3.0-or-later

# Print the glibc symbol version bindings for a glibc floor.
#
# Usage: glibc-symbols [-h|--help] <floor> <library>...
#
# For each symbol that the glibc libraries define, print the binding of the
# symbol to its latest version at <floor>, which has the <major>.<minor>
# form. Symbols that don't exist at the floor are left out. The libraries
# must belong to a glibc of the floor version or later and the first of them
# must be libc.so.6, from which we take the glibc version and the
# architecture.
#
# We commit the result to launcher/launcher/launcher-glibc-<cpu>.hxx (see
# launcher-glibc.hxx there), so this only needs to run when the floor
# changes. For example, on Fedora, from the repository root in a forwarded
# configuration:
#
# launcher/etc/private/glibc-symbols 2.36                    \
#   /usr/lib64/libc.so.6 /usr/lib64/libm.so.6                \
#   /usr/lib64/ld-linux-x86-64.so.2                          \
#   >launcher/launcher/launcher-glibc-x86_64.hxx
#
# Note that this script requires objdump, which is part of binutils.
#
usage="usage: $0 [-h|--help] <floor> <library>..."

trap 'exit 1' ERR
set -o errtrace # Trap in functions and subshells.
set -o pipefail # Fail if any pipeline command fails.

function info () { echo "$*" 1>&2; }
function error () { info "error: $*"; exit 1; }

function usage_error () # <message>
{
  info "error: $1"
  info "  info: run '$0 --help' for more information"
  exit 1
}

# Parse the command line.
#
floor=
libs=()

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      info "$usage"
      exit 0
      ;;
    -*)
      usage_error "unknown option '$1'"
      ;;
    *)
      if [[ -z "$floor" ]]; then
        floor="$1"
      else
        libs+=("$1")
      fi
      shift
      ;;
  esac
done

if [[ -z "$floor" ]]; then
  usage_error "glibc floor expected"
fi

if [[ ! "$floor" =~ ^[0-9]+\.[0-9]+$ ]]; then
  usage_error "invalid glibc floor '$floor'"
fi

if [[ "${#libs[@]}" -eq 0 ]]; then
  usage_error "glibc library expected"
fi

for l in "${libs[@]}"; do
  if [[ ! -f "$l" ]]; then
    error "'$l' does not exist"
  fi
done

if ! command -v objdump >/dev/null 2>&1; then
  error "unable to find objdump (binutils)"
fi

# The version and the architecture of the glibc, which go into the header
# comment and its name.
#
src="$(grep -aoE -m 1 'release version [0-9]+\.[0-9]+(\.[0-9]+)?' \
         "${libs[0]}" | sed -e 's/.* //')" || true

if [[ -z "$src" ]]; then
  error "no glibc version in '${libs[0]}', is it libc.so.6?"
fi

arch="$(objdump -f "${libs[0]}" |
          sed -n -e 's/^architecture: \([^,]*\),.*$/\1/p')"

case "$arch" in
  i386)        cpu=i386   ;;
  i386:x86-64) cpu=x86_64 ;;
  *)           error "unsupported architecture '$arch' of '${libs[0]}'" ;;
esac

# Each objdump -T symbol line ends with the version (in parentheses if it is
# not the default) and the name. We skip undefined symbols, which belong to
# other libraries, and versions other than GLIBC_<major>.<minor>[.<patch>]
# (GLIBC_PRIVATE, for example). Version definition lines have the version as
# the name, so we skip those as well.
#
bindings="$(objdump -T "${libs[@]}" | awk -v floor="$floor" '
function compare (a, b,    x, y, n, i)
{
  n = split (a, x, ".")

  if (split (b, y, ".") > n)
    n = length (y)

  for (i = 1; i <= n; i++)
  {
    if (x[i] + 0 != y[i] + 0)
      return x[i] + 0 < y[i] + 0 ? -1 : 1
  }

  return 0
}

NF < 3 || /\*UND\*/ { next }

{
  v = $(NF - 1)
  s = $NF

  gsub (/[()]/, "", v)

  if (v !~ /^GLIBC_[0-9]+\.[0-9]+(\.[0-9]+)?$/ || s == v)
    next

  n = substr (v, 7)

  if (compare(n, floor) > 0)
    next

  if (!(s in best) || compare(n, best[s]) > 0)
    best[s] = n
}

END {
  for (s in best)
    printf "__asm__ (\".symver %s,%s@GLIBC_%s\");\n", s, s, best[s]
}' | LC_ALL=C sort)"

if [[ -z "$bindings" ]]; then
  error "no glibc symbols in ${libs[*]}"
fi

cat <<EOF
// Copyright (c) the IW4x authors (see the AUTHORS file).
// SPDX-License-Identifier: GPL-3.0-or-later

// glibc symbol version bindings for the glibc $floor floor on $cpu (see
// launcher-glibc.hxx).
//
// Generated by launcher/etc/private/glibc-symbols $floor from glibc $src
// ($cpu). To change, regenerate this file.
//
#pragma once

$bindings
EOF
